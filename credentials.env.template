# Avenfield skill credentials — copy this to ~/.avenfield/credentials.env on
# EACH device and paste in the real values. This file (the template) is safe
# to commit; the real ~/.avenfield/credentials.env is NEVER committed.
#
#   cp skills/credentials.env.template ~/.avenfield/credentials.env
#   chmod 600 ~/.avenfield/credentials.env
#   # then edit and paste your keys

# Cloudflare Browser Rendering (avenfield-browser-render)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# OpenAI (avenfield-extract, summaries, scoring)
OPENAI_API_KEY=

# OmniVerifier email verification (avenfield-verify)
OMNIVERIFIER_API_KEY=

# Instantly v2 (avenfield-instantly)
INSTANTLY_API_KEY=

# Google Sheets (avenfield-sheets) — path to the service-account JSON on THIS
# device. Copy the JSON file to each device too; it is not in git.
GOOGLE_APPLICATION_CREDENTIALS=
SHEETS_PARENT_FOLDER_ID=
